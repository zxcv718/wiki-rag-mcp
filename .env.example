# 가상 위키 생성(tools/wikigen) 등 서버 밖 LLM 작업에 쓰는 설정입니다.
# .env로 복사해 키를 넣습니다. .env는 커밋하지 않습니다.
# 코디세이 Public API(COPA)의 OpenAI 호환 키: POST {COPA_BASE_URL}/v1/chat/completions, Authorization: Bearer
COPA_BASE_URL=https://copa.codyssey.kr
COPA_API_KEY=
WIKIGEN_MODEL=gpt-5.4

# 상용 임베딩 비교 실험(ADR-11)에만 쓰는 Gemini API 키. 서버는 쓰지 않는다.
# Google AI Studio(https://aistudio.google.com/apikey)에서 무료로 발급한다.
GEMINI_API_KEY=
