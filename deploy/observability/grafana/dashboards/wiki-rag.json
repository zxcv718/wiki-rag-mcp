{
  "uid": "wiki-rag",
  "title": "wiki-rag-mcp",
  "tags": [
    "wiki-rag",
    "ADR-15"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": false,
  "panels": [
    {
      "type": "row",
      "title": "검색 (search_wiki)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "단계별 p95",
      "description": "설계서 8장 지연 예산: 권한 해석 20ms, 쿼리 임베딩 100ms, 벡터 검색 150ms, 결과 조립 30ms. search_wiki 전체 목표는 p95 800ms다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(wiki_search_stage_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "초당 검색",
      "description": "권한 해석 단계에 들어온 search_wiki 호출 수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(wiki_search_stage_duration_seconds_count{stage=\"principals\"}[$__rate_interval]))",
          "legendFormat": "search_wiki"
        }
      ]
    },
    {
      "type": "stat",
      "title": "그룹 캐시 적중률",
      "description": "화면의 시간 범위에서 Redis 그룹 캐시가 맞힌 비율. 못 맞히면 위키에 그룹을 묻는다(ADR-08)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(wiki_group_cache_lookups_total{result=\"hit\"}[$__range])) / sum(increase(wiki_group_cache_lookups_total[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "인덱싱",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "반영 지연 p95",
      "description": "위키가 이벤트를 아웃박스에 기록한 때부터 반영하기까지. 문서: 검색 인덱스에 반영(목표 30초, 빨간 점선). 그룹: 멤버십 변경으로 그룹 캐시를 무효화해 검색 권한이 바뀌기까지(ADR-08)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(wiki_indexing_lag_seconds_bucket{outcome=\"indexed\"}[5m])))",
          "legendFormat": "문서"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "legendFormat": "그룹",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(wiki_indexing_lag_seconds_bucket{outcome=\"invalidated\"}[5m])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "처리 안 된 이벤트",
      "description": "events: 문서 스트림에 남은 이벤트, membership: 멤버십 스트림에 남은 이벤트, dlq: 세 번 재시도해도 실패해 DLQ로 옮긴 문서 이벤트(10분마다 다시 넣는다)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (queue) (wiki_indexing_queue_length)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "분당 임베딩",
      "description": "query: 검색 쿼리, document: 바뀐 청크. 바뀌지 않은 청크는 저장된 임베딩을 다시 쓴다(ADR-10)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (kind) (rate(wiki_embedding_texts_total[$__rate_interval])) * 60",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "위키 서비스",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "API 평균 응답 시간",
      "description": "위키 서비스가 요청을 처리한 평균 시간(경로 템플릿별)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_milliseconds_sum{job=\"wiki-service\"}[$__rate_interval])) / sum by (uri) (rate(http_server_requests_milliseconds_count{job=\"wiki-service\"}[$__rate_interval]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM 힙",
      "description": "운영에서는 -Xmx512m으로 묶는다(deploy/compose.yaml)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"wiki-service\", area=\"heap\"})",
          "legendFormat": "사용"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{job=\"wiki-service\", area=\"heap\"})",
          "legendFormat": "상한"
        }
      ]
    },
    {
      "type": "row",
      "title": "추적 (Tempo)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "최근 search_wiki",
      "description": "줄을 누르면 단계별 스팬과 위키 호출을 볼 수 있다",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{name=\"tools/call search_wiki\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "table",
      "title": "최근 인덱싱",
      "description": "문서를 고친 요청부터 워커의 반영까지가 한 추적이다",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{span.messaging.operation.type=\"process\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    }
  ]
}
